YEAR=2022
DIR_NAME=$2
case $1 in
     clean)
        rm -rf result
        cargo clean
        ;;
    start)
        mkdir -p src/bin/d${DIR_NAME}
        cd src/bin/d$2
        aoc download -y $YEAR -d ${DIR_NAME}
        cp ../../main.rs .
        cd ../../..
        ;;
    refresh)
        cd src/bin/d$2
        rm -f input
        rm -f puzzle.md
        aoc download -y $YEAR -d ${DIR_NAME}
        cd ../..
        ;;
    refreshAll)
        for DAY in $(ls src/bin);
        do
            echo ${DAY}
            cd src/bin/${DAY}
            rm -f input
            rm -f puzzle.md
            aoc download -y $YEAR -d ${DAY:1}
            cd ../../..
            echo
        done
        ;;
    getInput)
        cd src/bin/d$2
        rm -f input
        aoc download -I -y $YEAR -d ${DIR_NAME}
        cd ../..
        ;;
    build)
        buildPhase
        ;;
    install)
        buildPhase
        installPhase
        ;;
    runDay)
        cargo build --release --bin d${DIR_NAME}
        time  ./target/release/d${DIR_NAME} src/bin/d${DIR_NAME}/input
        ;;
    testDay)
        cargo build --release --bin d${DIR_NAME}
        time ./target/release/d${DIR_NAME} src/bin/d${DIR_NAME}/sample
        ;;
    runAll)
        cargo build --release --bins
        for DAY in $(ls src/bin);
        do
            echo ${DAY}
            time ./target/release/$DAY src/bin/${DAY}/input
            echo
        done
        ;;
    showInput)
        less src/bin/d${DIR_NAME}/input
        ;;
    showPuzzle)
        less src/bin/d${DIR_NAME}/puzzle.md
esac

